# Supabase Infrastructure
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Commerce Engine (Custom)
NEXT_PUBLIC_BRAND_ID=streetplayr-uuid-here

# NECTAR Ecosystem Bridge (server-only — see lib/nectar/client.ts)
# Prefer NECTAR_API_URL (Cloud Run HTTPS in production).
# NECTAR_SIGNING_SECRET must match platforms.signing_secret for id 'streetplayr'.
# PLATFORM_TOKEN_STREETPLAYR is accepted as a fallback signing token.
NECTAR_API_URL=http://localhost:3001
NECTAR_SIGNING_SECRET=your-streetplayr-platform-signing-secret
# PLATFORM_TOKEN_STREETPLAYR=
# Inbound wallet sync webhook (Nectar → StreetPlayR): POST /api/webhooks/nectar
# Cron wallet sync: GET /api/cron/sync-wallet-balances (Bearer CRON_SECRET)

# Content & Experience
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Media Pipeline
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Phone Authentication
NEXT_PUBLIC_PHONE_PREFIX=+91

# Easebuzz (primary INR gateway — server-only secrets)
# Test and Live use DIFFERENT Merchant Key + Salt pairs.
# EASEBUZZ_ENV must be exactly 'test' or 'prod'.
# EASEBUZZ_MERCHANT_KEY=
# EASEBUZZ_SALT=
# EASEBUZZ_ENV=test
# NEXT_PUBLIC_SITE_URL must be public HTTPS for surl/furl callbacks.

# Unicommerce
# UNICOMMERCE_API_URL=https://your-tenant.unicommerce.com
# UNICOMMERCE_USERNAME=
# UNICOMMERCE_PASSWORD=
# UNICOMMERCE_FACILITY_CODE=
# UNICOMMERCE_CHANNEL_CODE=CUSTOM
# UNICOMMERCE_WEBHOOK_SECRET=
# UNICOMMERCE_CLIENT_ID=
# DEMO_INVENTORY_MODE=false

# Cron Authorization
# CRON_SECRET=<uuid>

# Catalog policy — production must keep this 0 / unset (never auto-demo).
# USE_LOCAL_CATALOG=0

# AI Virtual Try-On
NEXT_PUBLIC_AI_TRYON_ENABLED=true
AI_TRYON_PROVIDER=idmvton
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
AI_TRYON_DAILY_LIMIT=500
AI_TRYON_USER_DAILY_LIMIT=3
AI_TRYON_MODEL=imagen-3.0-generate-002
